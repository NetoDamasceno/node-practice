<!DOCTYPE html>
<html lang="pt-BR">
  <%- include("./partials/head.ejs") %>

  <body class="min-h-screen bg-slate-50 text-slate-900">
    <%- include("./partials/navbar.ejs") %>

    <main class="mx-auto w-full max-w-3xl px-6 py-8">

      <div class="mb-8">
        <a
          href="/views/clients"
          class="text-sm font-medium text-slate-500 transition hover:text-slate-900"
        >
          ← Voltar para clientes
        </a>

        <h2 class="mt-4 text-2xl font-bold tracking-tight">
          Novo cliente
        </h2>

        <p class="mt-1 text-sm text-slate-500">
          Cadastre um novo cliente no sistema.
        </p>
      </div>


      <form
        action="/views/clients"
        method="POST"
        class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"
      >
       <% if (errors && Object.keys(errors).length > 0) { %>
        <div class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3">
          <p class="text-sm font-medium text-red-800">
            Não foi possível cadastrar o cliente.
          </p>

          <p class="mt-1 text-sm text-red-700">
            Verifique os campos destacados abaixo.
          </p>
        </div>
       <% } %>

        <div class="grid gap-6 sm:grid-cols-2">

          <!-- Nome -->
          <div>
            <label
              for="firstName"
              class="mb-2 block text-sm font-medium text-slate-700"
            >
              Nome
            </label>

            <input
              type="text"
              id="firstName"
              name="firstName"
              value="<%= formData?.firstName || "" %>"
              required
              class="<%= errors?.firstName
                ? 'w-full rounded-lg border border-red-400 px-3 py-2.5 text-sm outline-none transition focus:border-red-500 focus:ring-2 focus:ring-red-100'
                : 'w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-200'
              %>"
            />

            <% if (errors?.firstName) { %>
              <p class="mt-1.5 text-xs text-red-600">
                <%= errors.firstName[0] %>
              </p>
            <% } %>
          </div>


          <!-- Sobrenome -->
          <div>
            <label
              for="lastName"
              class="mb-2 block text-sm font-medium text-slate-700"
            >
              Sobrenome
            </label>

            <input
              type="text"
              id="lastName"
              name="lastName"
              value="<%= formData?.lastName || "" %>"
              required
              class="<%= errors?.lastName
                ? 'w-full rounded-lg border border-red-400 px-3 py-2.5 text-sm outline-none transition focus:border-red-500 focus:ring-2 focus:ring-red-100'
                : 'w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-200'
              %>"
            />

            <% if (errors?.lastName) { %>
              <p class="mt-1.5 text-xs text-red-600">
                <%= errors.lastName[0] %>
              </p>
            <% } %>
          </div>


          <!-- Email -->
          <div>
            <label
              for="email"
              class="mb-2 block text-sm font-medium text-slate-700"
            >
              E-mail
            </label>

            <input
              type="email"
              id="email"
              name="email"
              value="<%= formData?.email || "" %>"
              required
              class="<%= errors?.email
                ? 'w-full rounded-lg border border-red-400 px-3 py-2.5 text-sm outline-none transition focus:border-red-500 focus:ring-2 focus:ring-red-100'
                : 'w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-200'
              %>"
            />

            <% if (errors?.email) { %>
              <p class="mt-1.5 text-xs text-red-600">
                <%= errors.email[0] %>
              </p>
            <% } %>
          </div>


          <!-- Telefone -->
          <div>
            <label
              for="phone"
              class="mb-2 block text-sm font-medium text-slate-700"
            >
              Telefone
            </label>

            <input
              type="tel"
              id="phone"
              name="phone"
              value="<%= formData?.phone || "" %>"
              required
              class="<%= errors?.phone
                ? 'w-full rounded-lg border border-red-400 px-3 py-2.5 text-sm outline-none transition focus:border-red-500 focus:ring-2 focus:ring-red-100'
                : 'w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-200'
              %>"
            />

            <% if (errors?.phone) { %>
              <p class="mt-1.5 text-xs text-red-600">
                <%= errors.phone[0] %>
              </p>
            <% } %>
          </div>


          <!-- Status -->
          <div class="sm:col-span-2">
            <label
              for="status"
              class="mb-2 block text-sm font-medium text-slate-700"
            >
              Status
            </label>

            <select
              id="status"
              name="status"
              class="<%= errors?.status
                ? 'w-full rounded-lg border border-red-400 bg-white px-3 py-2.5 text-sm outline-none transition focus:border-red-500 focus:ring-2 focus:ring-red-100'
                : 'w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-200'
              %>"
            >
              <option
                value="new"
                <%= formData?.status === "new" || !formData?.status ? "selected" : "" %>
              >
                Novo
              </option>

              <option
                value="contacted"
                <%= formData?.status === "contacted" ? "selected" : "" %>
              >
                Em contato
              </option>

              <option
                value="customer"
              <%= formData?.status === "customer" ? "selected" : "" %>
              >
               Cliente
              </option>
            </select>

            <% if (errors?.status) { %>
              <p class="mt-1.5 text-xs text-red-600">
                <%= errors.status[0] %>
              </p>
            <% } %>
          </div>

        </div>


        <div class="mt-8 flex justify-end gap-3 border-t border-slate-100 pt-6">

          <a
            href="/views/clients"
            class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
          >
            Cancelar
          </a>

          <button
            type="submit"
            class="rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-700"
          >
            Cadastrar cliente
          </button>

        </div>

      </form>

    </main>
  </body>
</html>