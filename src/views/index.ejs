<!DOCTYPE html>
<html lang="pt-BR">
  <%- include("./partials/head.ejs") %>

  <body class="min-h-screen bg-slate-50 text-slate-900">
    <%- include("./partials/navbar.ejs") %>

    <main class="mx-auto w-full max-w-7xl px-6 py-8">
      
      <!-- Header da página -->
      <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-slate-900">
            Clientes
          </h2>

          <p class="mt-1 text-sm text-slate-500">
            Gerencie seus clientes em um só lugar.
          </p>
        </div>

        <a
          href="/views/clients/new"
          class="rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-700"
        >
          + Novo cliente
        </a>
      </div>


      <!-- Cards -->
      <div class="mb-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        
        <!-- Total -->
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <p class="text-sm font-medium text-slate-500">
            Total de clientes
          </p>

          <p class="mt-2 text-3xl font-bold text-slate-900">
            <%= clients.length %>
          </p>
        </div>


        <!-- Novos -->
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <p class="text-sm font-medium text-slate-500">
            Novos
          </p>

          <p class="mt-2 text-3xl font-bold text-slate-900">
            <%= clients.filter(client => client.status === "new").length %>
          </p>
        </div>


        <!-- Clientes -->
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <p class="text-sm font-medium text-slate-500">
            Clientes ativos
          </p>

          <p class="mt-2 text-3xl font-bold text-slate-900">
            <%= clients.filter(client => client.status === "customer").length %>
          </p>
        </div>

      </div>


      <!-- Tabela -->
      <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        
        <div class="border-b border-slate-200 px-6 py-5">
          <h3 class="font-semibold text-slate-900">
            Lista de clientes
          </h3>

          <p class="mt-1 text-sm text-slate-500">
            Visualize os clientes cadastrados no sistema.
          </p>
        </div>


        <% if (clients.length > 0) { %>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              
              <thead class="bg-slate-50 text-xs uppercase text-slate-500">
                <tr>
                  <th class="px-6 py-4 font-semibold">
                    Cliente
                  </th>

                  <th class="px-6 py-4 font-semibold">
                    E-mail
                  </th>

                  <th class="px-6 py-4 font-semibold">
                    Telefone
                  </th>

                  <th class="px-6 py-4 font-semibold">
                    Status
                  </th>

                  <th class="px-6 py-4 text-right font-semibold">
                    Ações
                  </th>
                </tr>
              </thead>


              <tbody class="divide-y divide-slate-100">
                <% clients.forEach(client => { %>

                  <tr class="transition hover:bg-slate-50">

                    <!-- Cliente -->
                    <td class="whitespace-nowrap px-6 py-4">
                      <div class="flex items-center gap-3">

                        <div
                          class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 text-xs font-semibold text-slate-600"
                        >
                          <%= client.firstName.charAt(0).toUpperCase() %>
                        </div>

                        <div>
                          <p class="font-medium text-slate-900">
                            <%= client.firstName %> <%= client.lastName %>
                          </p>
                        </div>

                      </div>
                    </td>


                    <!-- E-mail -->
                    <td class="whitespace-nowrap px-6 py-4 text-slate-500">
                      <%= client.email %>
                    </td>


                    <!-- Telefone -->
                    <td class="whitespace-nowrap px-6 py-4 text-slate-500">
                      <%= client.phone %>
                    </td>


                    <!-- Status -->
                    <td class="whitespace-nowrap px-6 py-4">

                      <% if (client.status === "new") { %>

                        <span
                          class="inline-flex rounded-full bg-blue-50 px-2.5 py-1 text-xs font-medium text-blue-700"
                        >
                          Novo
                        </span>

                      <% } else if (client.status === "contacted") { %>

                        <span
                          class="inline-flex rounded-full bg-amber-50 px-2.5 py-1 text-xs font-medium text-amber-700"
                        >
                          Em contato
                        </span>

                      <% } else if (client.status === "customer") { %>

                        <span
                          class="inline-flex rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700"
                        >
                           Cliente
                        </span>

                      <% } %>

                    </td>


                    <!-- Ações -->
                    <td class="whitespace-nowrap px-6 py-4">
                      <div class="flex justify-end gap-2">

                        <!-- Editar -->
                        <a
                          href="/views/clients/<%= client._id %>/edit"
                          class="rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900"
                        >
                          Editar
                        </a>


                        <!-- Excluir -->
                        <form
                          action="/views/clients/<%= client._id %>/delete"
                          method="POST"
                          onsubmit="return confirm('Tem certeza que deseja excluir este cliente?')"
                        >

                          <button
                            type="submit"
                            class="rounded-lg border border-red-200 px-3 py-1.5 text-xs font-medium text-red-600 transition hover:bg-red-50"
                          >
                            Excluir
                          </button>

                        </form>

                      </div>
                    </td>

                  </tr>

                <% }) %>
              </tbody> 
            </table>
          </div>

        <% } else { %>

          <!-- Estado vazio -->
          <div class="px-6 py-16 text-center">
            <h3 class="text-lg font-semibold text-slate-900">
              Nenhum cliente cadastrado
            </h3>

            <p class="mt-2 text-sm text-slate-500">
              Cadastre seu primeiro cliente para começar.
            </p>
          </div>

        <% } %>

      </div>

    </main>
  </body>
</html>