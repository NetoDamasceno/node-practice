<!DOCTYPE html>
<html lang="pt-BR">
  <%- include("./partials/head.ejs") %>

  <body class="min-h-screen bg-slate-50 text-slate-900">
    <%- include("./partials/navbar.ejs") %>

    <main class="mx-auto w-full max-w-3xl px-6 py-8">

      <div class="mb-8">
        <a
          href="/views/clients"
          class="text-sm font-medium text-slate-500 transition hover:text-slate-900"
        >
          ← Voltar para clientes
        </a>

        <h2 class="mt-4 text-2xl font-bold tracking-tight">
          Editar cliente
        </h2>

        <p class="mt-1 text-sm text-slate-500">
          Atualize as informações do cliente.
        </p>
      </div>


      <form
        action="/views/clients/<%= client._id %>/edit"
        method="POST"
        class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"
      >

        <div class="grid gap-6 sm:grid-cols-2">

          <!-- Nome -->
          <div>
            <label
              for="firstName"
              class="mb-2 block text-sm font-medium text-slate-700"
            >
              Nome
            </label>

            <input
              type="text"
              id="firstName"
              name="firstName"
              value="<%= client.firstName %>"
              required
              class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-200"
            />
          </div>


          <!-- Sobrenome -->
          <div>
            <label
              for="lastName"
              class="mb-2 block text-sm font-medium text-slate-700"
            >
              Sobrenome
            </label>

            <input
              type="text"
              id="lastName"
              name="lastName"
              value="<%= client.lastName %>"
              required
              class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-200"
            />
          </div>


          <!-- E-mail -->
          <div>
            <label
              for="email"
              class="mb-2 block text-sm font-medium text-slate-700"
            >
              E-mail
            </label>

            <input
              type="email"
              id="email"
              name="email"
              value="<%= client.email %>"
              required
              class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-200"
            />
          </div>


          <!-- Telefone -->
          <div>
            <label
              for="phone"
              class="mb-2 block text-sm font-medium text-slate-700"
            >
              Telefone
            </label>

            <input
              type="tel"
              id="phone"
              name="phone"
              value="<%= client.phone %>"
              required
              class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-200"
            />
          </div>


          <!-- Status -->
          <div class="sm:col-span-2">
            <label
              for="status"
              class="mb-2 block text-sm font-medium text-slate-700"
            >
              Status
            </label>

            <select
              id="status"
              name="status"
              class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-200"
            >

              <option
                value="new"
                <%= client.status === "new" ? "selected" : "" %>
              >
                Novo
              </option>

              <option
                value="contacted"
                <%= client.status === "contacted" ? "selected" : "" %>
              >
                Em contato
              </option>

              <option
                value="customer"
                <%= client.status === "customer" ? "selected" : "" %>
              >
                Cliente
              </option>

            </select>
          </div>

        </div>


        <div class="mt-8 flex justify-end gap-3 border-t border-slate-100 pt-6">

          <a
            href="/views/clients"
            class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
          >
            Cancelar
          </a>

          <button
            type="submit"
            class="rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-700"
          >
            Salvar alterações
          </button>

        </div>

      </form>

    </main>
  </body>
</html>